aws_region             = "ap-south-1"
project_name           = "bookshelf"
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24"]
eks_node_instance_type = "t3.medium"
eks_desired_capacity   = 2
